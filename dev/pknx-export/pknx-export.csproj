<!-- DEV ONLY. Dumps trainers and wild encounters out of your own Sword/Shield
     romfs for dev/gen_romdata.py. Needs a clone of kwsch/pkNX (path below, or
     -p:PkNX=...) and Oodle's oo2core_8_win64.dll next to the built exe. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PkNX Condition="'$(PkNX)' == ''">$(USERPROFILE)\pknx</PkNX>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PkNX)\pkNX.Game\pkNX.Game.csproj" />
  </ItemGroup>
</Project>
